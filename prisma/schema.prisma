generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Decision {
  id          String           @id @default(cuid())
  userId      String?
  anonId      String?
  title       String
  category    String?
  background  String
  concern     String?
  fear        String?
  emotions    String?          // JSON string, for example ["anxious","curious"]
  deadline    DateTime?
  aiAnalysis  String?          // JSON string returned by the AI analysis step
  finalChoice String?
  status      DecisionStatus   @default(DRAFT)
  reviewDate  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  options     DecisionOption[]
  review      DecisionReview?

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([reviewDate])
  @@index([userId])
  @@index([anonId])
}

model DecisionOption {
  id          String   @id @default(cuid())
  decisionId  String
  label       String
  description String?
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model DecisionReview {
  id               String   @id @default(cuid())
  decisionId       String   @unique
  actualResult     String
  regretScore      Int
  outcome          String?
  fearHappened     Boolean?
  wouldChooseAgain Boolean?
  lesson           String?
  reviewedAt       DateTime @default(now())
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  anonId             String?  @unique
  summary            String?
  commonCategories   String?  // JSON string
  commonConcerns     String?  // JSON string
  commonEmotions     String?  // JSON string
  commonBiases       String?  // JSON string
  lowRegretStrategies String? // JSON string
  highRegretPatterns String?  // JSON string
  lowRegretPatterns  String?  // JSON string
  updatedAt          DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 速率限制计数（按 key = identity|ip + 窗口）。早期用 DB；规模上来可换 KV/Redis。
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

enum DecisionStatus {
  DRAFT
  ANALYZED
  DECIDED
  REVIEWED
  ARCHIVED
}
