generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Decision {
  id          String           @id @default(cuid())
  userId      String?
  anonId      String?
  title       String
  category    String?
  background  String
  concern     String?
  fear        String?
  emotions    String?          // JSON string, for example ["anxious","curious"]
  deadline    DateTime?
  aiAnalysis  String?          // JSON string returned by the AI analysis step
  finalChoice String?
  status      DecisionStatus   @default(DRAFT)
  reviewDate  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  options     DecisionOption[]
  review      DecisionReview?

  @@index([userId])
  @@index([anonId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([reviewDate])
}

model DecisionOption {
  id          String   @id @default(cuid())
  decisionId  String
  label       String
  description String?
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model DecisionReview {
  id               String   @id @default(cuid())
  decisionId       String   @unique
  userId           String?
  anonId           String?
  actualResult     String
  regretScore      Int
  outcome          String?
  fearHappened     Boolean?
  wouldChooseAgain Boolean?
  lesson           String?
  reviewedAt       DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  anonId             String?  @unique
  summary            String?
  commonCategories   String?  // JSON string
  commonConcerns     String?  // JSON string
  commonEmotions     String?  // JSON string
  commonBiases       String?  // JSON string
  lowRegretStrategies String? // JSON string
  highRegretPatterns String?  // JSON string
  lowRegretPatterns  String?  // JSON string
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     UserSession[]
  decisions    Decision[]
  reviews      DecisionReview[]
  profiles     UserProfile[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

enum DecisionStatus {
  DRAFT
  ANALYZED
  DECIDED
  REVIEWED
  ARCHIVED
}
